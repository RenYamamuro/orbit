#!/bin/sh
# 公開（push）の前に、テストと sw.js の版の上げ忘れを確かめる。
# 有効にするには一度だけ: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1

node --test 'tests/*.test.mjs' >/tmp/orbit-test.log 2>&1 || {
  grep -E '^(✖|not ok)' /tmp/orbit-test.log
  echo "テストが失敗したので push を止めました（全文: /tmp/orbit-test.log）"
  exit 1
}

# 画面や処理を変えたのに VERSION が同じだと、端末側のキャッシュが入れ替わらない
base=$(git rev-parse -q --verify origin/main) || exit 0
changed=$(git diff --name-only "$base"..HEAD -- index.html i18n.js brands.js manifest.webmanifest fonts icons vendor)
if [ -n "$changed" ] && ! git diff "$base"..HEAD -- sw.js | grep -q '^+const VERSION'; then
  echo "アプリを変更していますが sw.js の VERSION が上がっていません:"
  echo "$changed" | sed 's/^/  /'
  exit 1
fi
exit 0
